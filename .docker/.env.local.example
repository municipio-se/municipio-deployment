# Copy to .env.local before running compose.local.yml.
# All values are local-only; do not reuse these for any deployed environment.

APP_IMAGE=ghcr.io/dannil76/municipio-deployment-labs:test-5.9.7

PUBLIC_DOMAIN=localhost

# Seed is bind-mounted from db/seed.sql via compose. Set to false if you
# want to skip demo seeding (e.g. starting from an empty WordPress).
INSTALL_DEMO_DB=true

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
