{
  "name": "municipio-se/municipio-deployment",
  "license": "MIT",
  "description": "Deployment of the Municipio Platform.",
  "authors": [
    {
      "name": "Sebastian Thulin",
      "email": "sebastian.thulin@helsingborg.se"
    },
    {
      "name": "Joel Bernerman",
      "email": "joel.bernerman@helsingborg.se"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "php-http/discovery": true,
      "roots/wordpress-core-installer": true
    },
    "optimize-autoloader": true,
    "process-timeout": 21600
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "type": "composer",
      "url": "https://packagist.org"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    }
  ],
  "require": {
    "php": "^8.0.0 || ^8.1.0 || ^8.2.0 || ^8.3.0",
    "composer/installers": "v2.3.0",
    "helsingborg-stad/acf-icon-field": "0.2.46",
    "helsingborg-stad/active-directory-api-wp-integration": "3.2.0",
    "helsingborg-stad/api-alarm-manager": "^2.4.1",
    "helsingborg-stad/api-event-manager": "3.18.4",
    "helsingborg-stad/api-exhibition-manager": "0.5.0",
    "helsingborg-stad/api-schools-manager": "0.26.1",
    "helsingborg-stad/api-sponsor-manager": "1.0.7",
    "helsingborg-stad/api-volunteer-manager": "^0.5.1",
    "helsingborg-stad/better-post-ui": "3.1.6",
    "helsingborg-stad/blade": "3.5.1",
    "helsingborg-stad/force-ssl": "3.0.3",
    "helsingborg-stad/modularity-frontend-form": "0.84.6",
    "helsingborg-stad/municipio-blank": "^1.0",
    "helsingborg-stad/municipio": "7.45.3",
    "helsingborg-stad/s3-local-index": "1.2.1",
    "helsingborg-stad/s3-uploads-custom-endpoint": "2.0.0",
    "helsingborg-stad/webhooks-manager": "1.3.3",
    "helsingborg-stad/wpmu-acf-google-maps-key": "1.0.1",
    "helsingborg-stad/wpmu-allow-cors": "^1.0",
    "helsingborg-stad/wpmu-network-admin-url": "2.0.4",
    "helsingborg-stad/wpmu-remove-user-endpoint": "^0.2.2",
    "humanmade/s3-uploads": "3.0.13",
    "roots/wordpress-core-installer": "v4.0.0",
    "roots/wordpress-no-content": "7.1.3",
    "wpackagist-plugin/acf-extended": "0.9.2.5",
    "wpackagist-plugin/classic-editor": "^1.6.3",
    "wpackagist-plugin/litespeed-cache": "7.8.1",
    "wpackagist-plugin/redis-cache": "^2.3.0",
    "wpackagist-plugin/simple-smtp": "^1.3.2",
    "wpackagist-plugin/simplify-admin-menus": "^1.3",
    "wpackagist-plugin/wp-rest-api-log": "^1.6.9",
    "wpengine/advanced-custom-fields-pro": "6.8.10",
    "helsingborg-stad/municipio-clone": "v1.6.3"
  },
  "extra": {
    "path": "/",
    "wordpress-install-dir": "wp",
    "installer-paths": {
      "wp-content/mu-plugins/{$name}": [
        "type:wordpress-muplugin",
        "wpengine/advanced-custom-fields-pro"
      ],
      "wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ]
    },
    "aws/aws-sdk-php": [
      "S3"
    ]
  },
  "scripts": {
    "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices",
    "pre-install-cmd": [
      "php composer-local-merge.php pre-install"
    ],
    "post-install-cmd": [
      "php composer-local-merge.php post-install",
      "mkdir -p wp-content/uploads/cache/blade-cache",
      "cp wp-content/plugins/redis-cache/includes/object-cache.php wp-content/object-cache.php"
    ],
    "pre-update-cmd": [
      "php composer-local-merge.php pre-install"
    ],
    "post-update-cmd": [
      "php composer-local-merge.php post-install",
      "composer dump-autoload -o --working-dir ./wp-content/plugins/s3-uploads/"
    ],
    "update-lockfile": "command -v act >/dev/null 2>&1 || brew install act; act -j composer-update --bind",
    "resolve-conflicts": [
      "git fetch origin",
      "git checkout stage",
      "git merge -X ours --no-edit origin/master || true",
      "git commit --no-edit || true"
    ],
    "pin-all-latest": [
      "bash -c 'set -euo pipefail; composer outdated --direct --format=json --ignore-platform-req=ext-imagick | jq -c \".installed[] | select(.latest != null and .latest != \\\"[none matched]\\\" and (.latest | startswith(\\\"dev-\\\") | not)) | {name:.name, version:.latest}\" | while read -r row; do PKG=$(echo \"$row\" | jq -r .name); VER=$(echo \"$row\" | jq -r .version); CURRENT=$(jq -r --arg p \"$PKG\" \".require[\\$p] // \\\"\\\"\" composer.json); if [ -z \"$CURRENT\" ]; then echo \"Skipping $PKG (not in root composer.json)\"; elif [[ \"$CURRENT\" == dev-* ]]; then echo \"Skipping $PKG (current version is dev)\"; else echo \"Updating $PKG to $VER\"; jq --arg p \"$PKG\" --arg v \"$VER\" \".require[\\$p] = \\$v\" composer.json > composer.json.tmp && mv composer.json.tmp composer.json; fi; done'",
      "composer update --lock --ignore-platform-req=ext-imagick -W"
    ],
    "dev": [
      ".devcontainer/scripts/setup-dev-package.sh"
    ],
    "devcontainer:clone": "wp municipio clone-batch --config=.devcontainer/sites.json && composer devcontainer:deactivate-ssl",
    "devcontainer:reset": ".devcontainer/scripts/setup.sh",
    "devcontainer:deactivate-ssl": "wp site list --field=url | xargs -i wp plugin deactivate force-ssl --url={}"
  }
}