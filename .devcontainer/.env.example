# GitHub personal access token with the read:packages scope.
GH_TOKEN=

# ACF Pro license key for the local development environment.
ACF_PRO_KEY=

# Local WordPress install configuration (used by setup.sh / devcontainer:reset)
# SITE_TYPE: "single" or "multisite". Leave unset to be prompted interactively.
SITE_TYPE=
SITE_TITLE="Municipio Local"
ADMIN_USER=superadmin
ADMIN_PASSWORD=superadmin
ADMIN_EMAIL=admin@example.com

MUNICIPIO_CLONE_USERNAME=
MUNICIPIO_CLONE_APPLICATION_PASSWORD=